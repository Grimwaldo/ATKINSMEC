# Build output - per Revit version under bin\ and obj\
bin/
obj/

# Visual Studio
.vs/
*.user
*.suo

# The old packages.config NuGet folder (240 MB); the SDK project restores
# from the NuGet cache now
packages/

# Installer build output - rebuilt by build-installer.ps1
installer/output/
installer/payload/
installer/exe/payload.zip
installer/payload-autovent/
installer/exe/payload-autovent.zip

# The tutorial video (54 MB) - regenerated by tests\video\make_video.py
docs/*.mp4

# What the harnesses and previews write when they run
tests/**/out/
tests/**/*.png
tests/video/frames/
tests/video/stills/
*.log

# Claude Code MCP servers - the paths in it are specific to this PC
.mcp.json
